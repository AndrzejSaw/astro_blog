---
const links = [
  { href: '/', label: 'Главная' },
  { href: '/about/', label: 'Обо мне' },
  { href: '/blog/', label: 'Блог' },
  { href: '/playground/', label: 'Песочница' },
];
---
<nav class="nav">
  {links.map((link) => (
    <a href={link.href} class="nav__link">
      {link.label}
    </a>
  ))}
</nav>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .nav__link {
    color: #4c1d95;
    text-decoration: none;
    font-weight: 600;
  }

  .nav__link:hover {
    text-decoration: underline;
  }
</style>
