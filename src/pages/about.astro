---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Обо мне';

const identity = {
  name: 'Мария Пименова',
  role: 'Фронтенд-разработчица и наставница',
  city: 'Санкт-Петербург',
  summary:
    'Помогаю командам строить производительные интерфейсы, преподаю современный веб и делюсь опытом на митапах.',
};

const skills = [
  'Astro и SSG/ISR',
  'React и экосистема Vite',
  'Tailwind CSS и дизайн-системы',
  'Тестирование (Vitest, Playwright)',
  'UX-исследования и дизайн-интервью',
  'Наставничество и ревью процессов',
];

const hobbies = [
  'веду курсы и авторские воркшопы',
  'пишу музыку на синтезаторах',
  'путешествую со сноубордом',
];
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="Мария Пименова — фронтенд-разработчица, преподаватель и автор блога о современном вебе."
    />
    <style define:vars={{ skillColor: '#312e81', fontWeight: '600', textCase: 'uppercase' }}>
      h1 {
        color: #4c1d95;
        font-size: 3rem;
        margin-bottom: 0.5rem;
      }

      h2 {
        color: #475569;
        margin-top: 2rem;
      }

      .skill {
        color: var(--skillColor);
        font-weight: var(--fontWeight);
        text-transform: var(--textCase);
        letter-spacing: 0.04em;
      }

      .meta {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin: 1.5rem 0;
        padding: 1rem;
        border-left: 4px solid #c4b5fd;
        background-color: #ede9fe;
      }
    </style>
  </head>
  <body>
    <Navigation />

    <main>
      <header>
        <h1>Обо мне</h1>
        <p>{identity.summary}</p>
      </header>

      <section class="meta">
        <span><strong>Имя:</strong> {identity.name}</span>
        <span><strong>Роль:</strong> {identity.role}</span>
        <span><strong>Город:</strong> {identity.city}</span>
      </section>

      <section>
        <h2>Что делаю</h2>
        <p>
          За последние годы я работала с продуктами разного масштаба: от образовательных платформ до медиа.
          Меня вдохновляет сочетать технологичность и заботу о пользователях, потому в работе много внимания
          уделяю исследованию поведения людей, метрикам, а также поддержке разработчиков внутри команд.
        </p>
        <p>
          Сейчас консультирую команды, помогаю запускать дизайн-системы и преподавать современный фронтенд.
          На блоге документирую эксперименты и практики, которые помогают расти вместе с рынком.
        </p>
      </section>

      <section>
        <h2>Навыки</h2>
        <ul>
          {skills.map((skill) => (
            <li class="skill">{skill}</li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Вдохновляет</h2>
        <ul>
          {hobbies.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p>
          Если хотите обсудить сотрудничество или образовательные активности — пишите в социальные сети ниже.
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>
